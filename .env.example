# Server Configuration
PORT=3000
NODE_ENV=development

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL / Cloud SQL Connection Variables (Object Method)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="insight_pro"
SQL_USER="app_user"
SQL_PASSWORD="MY_SQL_USER_PASSWORD"

# PostgreSQL / Cloud SQL Admin Variables (Drizzle Kit Migrations)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"

# GEMINI_API_KEY: Provided by AI Studio Secrets if needed
GEMINI_API_KEY="MY_GEMINI_API_KEY"
